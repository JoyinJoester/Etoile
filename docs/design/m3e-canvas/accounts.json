{
  "title": "Etoile · 账户与设置",
  "brief": "保留三种独立视觉风格，账户与语言操作具有完整标签。 示例数据仅用于布局。Nothing 是默认风格；本画布专门设计可切换的 Material 3 Expressive 模式，Miuix 另行保留。",
  "frame": "phone",
  "platform": "android",
  "paletteKey": "purple",
  "theme": {
    "dark": false,
    "bothModes": true,
    "contrast": "standard",
    "shape": "rounded",
    "font": "robotoFlex",
    "emphasized": true,
    "motion": "expressive"
  },
  "frames": [
    {
      "id": "signin",
      "name": "登录 GitHub",
      "x": 0,
      "y": 0,
      "note": "浏览公开内容无需登录。授权、设备代码和令牌是三种已有入口。"
    },
    {
      "id": "accounts",
      "name": "管理账户",
      "x": 492,
      "y": 0,
      "note": "当前账户有明确选中标记。删除需要确认具体账号；旋转设备后确认对象不变。"
    },
    {
      "id": "settings",
      "name": "设置",
      "x": 984,
      "y": 0,
      "note": "外观与语言各有独立页面。入口显示当前选择；返回保留选择与导航位置。"
    },
    {
      "id": "appearance",
      "name": "外观",
      "x": 1476,
      "y": 0,
      "note": "设计风格、明暗模式与配色在同一页面。选择立即预览；Nothing 保持默认并固定单色，M3E 与 Miuix 支持配色。全页滚动，大字体的配色网格改为单列。"
    },
    {
      "id": "language",
      "name": "语言",
      "x": 0,
      "y": 972,
      "note": "语言单独成页。原生应用保存后立即应用，重建页面时保留导航栈；使用语言本名方便找回选择。"
    },
    {
      "id": "public-profile",
      "name": "开发者",
      "x": 492,
      "y": 972,
      "note": "公开身份、关注关系和仓库分层展示；长简介自然换行。"
    },
    {
      "id": "connections",
      "name": "关注者",
      "x": 984,
      "y": 972,
      "note": "使用一致的用户行；分页、空状态和重试出现在列表末尾。"
    },
    {
      "id": "organizations",
      "name": "组织",
      "x": 1476,
      "y": 972,
      "note": "组织名称优先，说明次之；打开组织的公开资料。"
    },
    {
      "id": "stars",
      "name": "星标收藏",
      "x": 0,
      "y": 1944,
      "note": "标签过滤、管理与批量选择有明确入口。批量操作期间显示数量并保留选择。"
    },
    {
      "id": "labels",
      "name": "管理标签",
      "x": 492,
      "y": 1944,
      "note": "长标签列表独立滚动，新增字段和保存按钮始终能到达。删除与重命名就地反馈。"
    }
  ],
