<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Miuix declares minSdk 33 because RuntimeShader is its primary path.
         Etoile guards every shader call and keeps a Material fallback on
         Android 8–12, so the non-shader backdrop primitives remain usable. -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        android:minSdkVersion="33" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission
        android:name="android.permission.NFC"
        tools:node="remove" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:name=".EtoileApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="false"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Etoile"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".EtoileActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Etoile">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="s.team" />
                <data android:host="steamcommunity.com" />
                <data android:host="store.steampowered.com" />
            </intent-filter>
            <!-- Supported GitHub work-item links. Unknown GitHub paths are
                 intentionally not claimed and continue opening in a browser. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="github.com" android:pathPattern="/.*/.*/issues/.*" />
                <data android:scheme="https" android:host="www.github.com" android:pathPattern="/.*/.*/issues/.*" />
                <data android:scheme="https" android:host="github.com" android:pathPattern="/.*/.*/pull/.*" />
                <data android:scheme="https" android:host="www.github.com" android:pathPattern="/.*/.*/pull/.*" />
                <data android:scheme="https" android:host="github.com" android:pathPattern="/.*/.*/actions/runs/.*" />
                <data android:scheme="https" android:host="www.github.com" android:pathPattern="/.*/.*/actions/runs/.*" />
                <data android:scheme="https" android:host="github.com" android:pathPattern="/.*/.*/actions/jobs/.*" />
                <data android:scheme="https" android:host="www.github.com" android:pathPattern="/.*/.*/actions/jobs/.*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="openurl"
                    android:scheme="steam" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".steam.quickaccess.SteamAccountStatsWidgetProvider"
            android:exported="false"
            android:label="@string/steam_widget_account_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/steam_account_stats_widget_info" />
        </receiver>

        <receiver
            android:name=".steam.quickaccess.SteamRecentGamesWidgetProvider"
            android:exported="false"
            android:label="@string/steam_widget_recent_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/steam_recent_games_widget_info" />
        </receiver>

        <activity
            android:name=".steam.quickaccess.SteamWidgetConfigureActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/steam_widget_choose_account"
            android:theme="@style/Theme.Etoile" />

        <receiver
            android:name=".steam.alerts.data.SteamAlertReceiver"
            android:exported="false" />

        <service
            android:name=".steam.friends.chat.background.data.SteamChatBackgroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled persistent Steam CM connection for incoming chat notifications" />
        </service>

        <service
            android:name=".steam.friends.voice.background.SteamVoiceCallService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback"
            android:stopWithTask="false" />

        <receiver
            android:name=".steam.friends.chat.background.data.SteamChatBackgroundReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Share generated support logs and other cache attachments safely. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name="com.microsoft.identity.client.BrowserTabActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="msauth"
                    android:host="takagi.ru.monica"
                    android:path="/FwPDMDAjg96+0gxjMKKmnQS/dQA=" />
            </intent-filter>
        </activity>
        <service android:name="androidx.credentials.playservices.CredentialProviderMetadataHolder" tools:node="remove" />
        <activity android:name="androidx.credentials.playservices.HiddenActivity" tools:node="remove" />
        <activity android:name="com.google.android.gms.auth.api.signin.internal.SignInHubActivity" tools:node="remove" />
        <service android:name="com.google.android.gms.auth.api.signin.RevocationBoundService" tools:node="remove" />
        <activity android:name="androidx.slice.compat.SlicePermissionActivity" tools:node="remove" />
        <activity android:name="com.journeyapps.barcodescanner.CaptureActivity" tools:node="remove" />
        <activity android:name="com.yubico.yubikit.android.ui.OtpActivity" tools:node="remove" />
        <activity android:name="com.yubico.yubikit.android.ui.YubiKeyPromptActivity" tools:node="remove" />
        <receiver android:name="androidx.profileinstaller.ProfileInstallReceiver" tools:node="remove" />
    </application>

</manifest>
